RewriteEngine On
# Clean URL aplikasi. Jika server deploy gagal membuka route ini,
# pastikan mod_rewrite aktif dan AllowOverride mengizinkan .htaccess.

RewriteRule ^app/(assets|plugins|lime)/(.*)$ $1/$2 [L,QSA]

RewriteRule ^(?:app/)?$ index.php [L,QSA]
RewriteRule ^(?:app/)?public/?$ index.php [L,QSA]
RewriteRule ^(?:app/)?public/documents/([^/]+)/?$ views/documents/document_public_detail.php?id=$1 [L,QSA]
RewriteRule ^(?:app/)?login/?$ login.php [L,QSA]
RewriteRule ^(?:app/)?register/?$ register.php [L,QSA]
RewriteRule ^(?:app/)?logout/?$ logout.php [L,QSA]
RewriteRule ^(?:app/)?dashboard/?$ views/dashboard/dashboard.php [L,QSA]
RewriteRule ^(?:app/)?dashboard/visits/?$ views/visits/visit_management.php [L,QSA]

RewriteRule ^(?:app/)?admin/documents/?$ views/documents/document_management.php [L,QSA]
RewriteRule ^(?:app/)?admin/documents/action/?$ views/documents/document_action.php [L,QSA]
RewriteRule ^(?:app/)?admin/documents/add/?$ views/documents/document_add.php [L,QSA]
RewriteRule ^(?:app/)?admin/documents/([^/]+)/edit/?$ views/documents/document_edit.php?id=$1 [L,QSA]
RewriteRule ^(?:app/)?admin/documents/([^/]+)/approve/?$ views/documents/document_action.php?action=approve&id=$1 [L,QSA]
RewriteRule ^(?:app/)?admin/documents/([^/]+)/reject/?$ views/documents/document_action.php?action=reject&id=$1 [L,QSA]
RewriteRule ^(?:app/)?admin/documents/([^/]+)/delete/?$ views/documents/document_action.php?action=delete&id=$1 [L,QSA]
RewriteRule ^(?:app/)?admin/documents/([^/]+)/?$ views/documents/document_detail.php?id=$1 [L,QSA]

RewriteRule ^(?:app/)?categories/?$ views/categories/category_management.php [L,QSA]
RewriteRule ^(?:app/)?categories/([^/]+)/delete/?$ views/categories/category_management.php?action=delete&id=$1 [L,QSA]

RewriteRule ^(?:app/)?users/?$ views/users/user_management.php [L,QSA]
RewriteRule ^(?:app/)?users/([^/]+)/delete/?$ views/users/user_management.php?action=delete&id=$1 [L,QSA]

RewriteRule ^(?:app/)?files/preview/([^/]+)/?$ files/preview.php?id=$1 [L,QSA]
RewriteRule ^(?:app/)?files/download/([^/]+)/?$ files/download.php?id=$1 [L,QSA]
